    "kernel": "{{ANSI_CYAN}}",
    "host": "{{ANSI_YELLOW}}",
    "terminal": "{{ANSI_MAGENTA}}",
    "packages": "{{ANSI_GREEN}}",
    "uptime": "{{ANSI_BLUE}}",
    "cpu": "{{TEXT_SECONDARY}}",
    "memory": "{{TEXT_SECONDARY}}",
