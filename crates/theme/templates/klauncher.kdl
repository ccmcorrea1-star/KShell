// Generated by `cargo run -p kshell-theme-gen -- --write`; do not edit.
// Quiet Gruvbox workspace treatment. This fragment only adds visual defaults;
// existing outputs, rules, and binds remain owned by the main configuration.
layout {
    gaps {{GAP_MAIN}}
    background-color "{{BG_CANVAS}}"

    focus-ring {
        off
    }

    border {
        width {{BORDER_WIDTH}}
        active-color "{{BORDER_STRUCTURAL}}"
        inactive-color "{{BG_SURFACE}}"
    }

    shadow {
        off
    }
}

// Keep compositor-drawn corners nearly square and remove client shadows.
window-rule {
    geometry-corner-radius {{RADIUS_PANEL}}
    clip-to-geometry true
}

// Niri 26.04+ compositor blur for the launcher backdrop.
blur {
    passes {{BACKDROP_BLUR_PASSES}}
    offset {{BACKDROP_BLUR_OFFSET}}
}

layer-rule {
    match namespace="^{{LAUNCHER_NAMESPACE}}$"

    background-effect {
        blur true
        xray false
        noise 0
        saturation 1
    }
}

binds {
    // gtk4-layer-shell creates the overlay surface directly.
    {{LAUNCHER_BINDING}} repeat=false {
        spawn "{{LAUNCHER_COMMAND}}"
    }
}
