// KLauncher Niri configuration fragment.
// Quiet Gruvbox workspace treatment. This fragment only adds visual defaults;
// existing outputs, rules, and binds remain owned by the main configuration.
layout {
    gaps 8
    background-color "#1d2021"

    focus-ring {
        off
    }

    border {
        width 2
        active-color "#665c54"
        inactive-color "#282828"
    }

    shadow {
        off
    }
}

// Keep compositor-drawn corners nearly square and remove client shadows.
window-rule {
    geometry-corner-radius 2
    clip-to-geometry true
}

// Niri 26.04+ compositor blur for the launcher backdrop.
blur {
    passes 2
    offset 2
}

layer-rule {
    match namespace="^my-shell-launcher$"

    background-effect {
        blur true
        xray false
        noise 0
        saturation 1
    }
}

binds {
    // gtk4-layer-shell creates the overlay surface directly.
    Mod+Space repeat=false {
        spawn "klauncher"
    }
}
